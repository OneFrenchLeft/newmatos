generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["referentialIntegrity"]
}

datasource db {
  provider             = "mysql"
  url                  = env("DATABASE_URL")
  referentialIntegrity = "prisma"
}

model Group {
  id        String   @id @default(uuid())
  name      String   @unique
  movement  Movement
  createdAt DateTime @default(now())
  tents     Tent[]
}

model Tent {
  id             String     @id @default(uuid())
  // identifyingLabel can be a number string ("1", "42") or a name ("Bourgogne")
  identifyingLabel String
  size             Int
  unit             Unit      @default(GROUPE)
  state            State
  complete         Boolean   @default(true)
  integrated       Boolean   @default(false)
  type             String    @default("Canadienne")
  pegs             Int       @default(0)
  comments         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  groupId          String
  group            Group     @relation(fields: [groupId], references: [id])
  loans            TentLoan[]

  @@unique([groupId, identifyingLabel], name: "TentIdentifier")
}

model TentLoan {
  id         String    @id @default(uuid())
  tentId     String
  tent       Tent      @relation(fields: [tentId], references: [id])
  borrower   Unit
  loanedAt   DateTime  @default(now())
  returnedAt DateTime?
  note       String?
}

enum Movement {
  SGDF
}

enum Unit {
  FARFADETS
  JEANNETTES
  LOUVETEAUX
  GUIDES
  SCOUTS
  PIONNIERS
  CARAVELLES
  COMPAGNONS
  RESPONSABLES
  GROUPE
}

enum State {
  INUTILISABLE
  MAUVAIS
  BON
  NEUF
}
