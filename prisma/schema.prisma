generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["referentialIntegrity"]
}

datasource db {
  provider             = "mysql"
  url                  = env("DATABASE_URL")
  referentialIntegrity = "prisma"
}

model Group {
  id        String   @id @default(uuid())
  name      String   @unique
  movement  Movement
  createdAt DateTime @default(now())
  tents     Tent[]
}

model Tent {
  id               String       @id @default(uuid())
  identifyingLabel String
  size             Int
  unit             Unit         @default(GROUPE)
  state            State
  complete         Boolean      @default(true)
  integrated       Boolean      @default(false)
  type             String       @default("Canadienne")
  pegs             Int          @default(0)
  comments         String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  groupId          String
  group            Group        @relation(fields: [groupId], references: [id])
  loans            TentLoan[]
  repairTasks      RepairTask[]

  @@unique([groupId, identifyingLabel], name: "TentIdentifier")
}

model TentLoan {
  id         String    @id @default(uuid())
  tentId     String
  tent       Tent      @relation(fields: [tentId], references: [id])
  borrower   Unit
  loanedAt   DateTime  @default(now())
  returnedAt DateTime?
  note       String?
}

model RepairTask {
  id          String   @id @default(uuid())
  tentId      String
  tent        Tent     @relation(fields: [tentId], references: [id])
  description String
  assignedTo  String   @default("")
  done        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

enum Movement {
  SGDF
  SGDFM
  SUF
  AGSE
  EEUDF
  EEDF
  EEIDF
}

enum Unit {
  FARFADETS
  JEANNETTES
  LOUVETEAUX
  GUIDES
  SCOUTS
  PIONNIERS
  CARAVELLES
  COMPAGNONS
  RESPONSABLES
  LOUVETEAUX_JEANNETTES
  SCOUTS_GUIDES
  PIONNIERS_CARAVELLES
  GROUPE
}

enum State {
  INUTILISABLE
  MAUVAIS
  EN_REPARATION
  BON
  NEUF
}
